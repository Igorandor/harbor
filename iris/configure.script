zn "%SYS"
write $zversion,!
set properties("Password")="HarborLocal-2026!",properties("ChangePassword")=0
write $SYSTEM.Status.GetErrorText(##class(Security.Users).Modify("SuperUser",.properties)),!
set app("Enabled")=1,app("AutheEnabled")=32
write $SYSTEM.Status.GetErrorText(##class(Security.Applications).Modify("/api/admin",.app)),!
halt
