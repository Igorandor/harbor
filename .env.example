# Fixed upstream; users cannot redirect the proxy to arbitrary hosts.
IRIS_URL=http://127.0.0.1:52773
PORT=3100
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5173
# Set true when served behind HTTPS.
COOKIE_SECURE=false
HARBOR_MODE=evaluation
IRIS_INSTANCE_ID=harbor-evaluation
HARBOR_DATA_DIR=data
# In deployment mode, use HTTPS upstream or explicitly allow a private IRIS network.
ALLOW_PRIVATE_IRIS_HTTP=false
